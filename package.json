{
  "name": "dsh-term-dict",
  "version": "0.2.1",
  "description": "跨会话的术语字典：查／写／体检三条工具、设置面板与自动注入；对话中自动检测新称谓，候选按跨会话权重转正，写入按 EVID／结论模板硬校验。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "activation.js",
    "weights.js",
    "detect-format.js",
    "cordis.patch.yml",
    "assets",
    "src",
    "lib/client.js",
    "scripts",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-alpha.1"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "glossary",
    "terminology",
    "dictionary",
    "detection",
    "context",
    "ui"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "check": "node --check index.js && node --check activation.js && node --check weights.js && node --check detect-format.js && node --check scripts/smoke.mjs && node --check scripts/build-client.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "author": "taoziliyouchong",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/taoziliyouchong/dsh-term-dict"
  },
  "homepage": "https://github.com/taoziliyouchong/dsh-term-dict#readme",
  "bugs": {
    "url": "https://github.com/taoziliyouchong/dsh-term-dict/issues"
  }
}
